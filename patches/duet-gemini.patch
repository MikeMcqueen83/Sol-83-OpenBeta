+    def test_scheduler_may_lead_a_third_agent(self) -> None:
+        agents = [duet.Agent(name=n, backend=b) for n, b in
+                  (("claude", "claude"), ("codex", "codex"), ("gemini", "gemini"))]
+        cfg = duet.DuetConfig(agents=agents, task="x", cwd=pathlib.Path("."))
+        with mock.patch.dict(duet.os.environ, {"DUET_TURN_SCHEDULER": ""}):
+            with self.assertRaises(SystemExit):
+                duet.validate_config(cfg)
+        with mock.patch.dict(duet.os.environ, {"DUET_TURN_SCHEDULER": "m:f"}):
+            duet.validate_config(cfg)
+        self.assertEqual([duet.next_speaker_idx(i, agents) for i in range(3)], [1, 2, 0])
 
     def test_effective_uses_agent_override(self) -> None:
         agent = duet.Agent(name="x", backend="claude", reasoning_effort="high")
